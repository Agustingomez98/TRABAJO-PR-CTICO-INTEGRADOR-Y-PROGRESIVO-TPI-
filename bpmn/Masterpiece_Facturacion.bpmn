<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Masterpiece" targetNamespace="https://utn.example/masterpiece/tpi4" exporter="Masterpiece TPI4" exporterVersion="1.0">
  <bpmn:message id="Message_Venta" name="Venta confirmada"/>
  <bpmn:message id="Message_Solicitud" name="Solicitud de autorizacion de comprobante"/>
  <bpmn:message id="Message_Resultado" name="Respuesta de autorizacion fiscal"/>
  <bpmn:collaboration id="Collaboration_Masterpiece">
    <bpmn:participant id="Participant_Canales" name="Plataformas de venta externas"/>
    <bpmn:participant id="Participant_ARCA" name="ARCA - Organismo fiscal externo"/>
    <bpmn:participant id="Participant_Masterpiece" name="Masterpiece" processRef="Process_Masterpiece"/>
    <bpmn:messageFlow id="MessageFlow_Venta" name="Venta confirmada" sourceRef="Participant_Canales" targetRef="Start_Venta" messageRef="Message_Venta"/>
    <bpmn:messageFlow id="MessageFlow_Solicitud" name="Solicitud de autorizacion" sourceRef="Task_Enviar" targetRef="Participant_ARCA" messageRef="Message_Solicitud"/>
    <bpmn:messageFlow id="MessageFlow_Resultado" name="Respuesta: CAE o rechazo" sourceRef="Participant_ARCA" targetRef="Task_Recibir" messageRef="Message_Resultado"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Masterpiece" name="Facturacion electronica integrada - Masterpiece" isExecutable="false">
    <bpmn:documentation>Proceso propuesto a partir de las Entregas 1, 2 y 3 del TPI. Inicio: venta confirmada de los canales digitales. Salida habitual: factura electronica autorizada por ARCA y stock actualizado. Excepciones: venta no facturable y rechazo/incidencia de ARCA, ambos con gestion administrativa. El comportamiento interno de las plataformas externas y ARCA no esta documentado, por eso se muestran como pools de caja negra.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Masterpiece">
      <bpmn:lane id="Lane_Sistema" name="Sistema automatizado - Modulo de facturacion e inventario">
        <bpmn:flowNodeRef>Start_Venta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Centralizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aptitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ARCA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Exito</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Administracion y Finanzas">
        <bpmn:flowNodeRef>Task_RevisarVenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PendienteDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Incidencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PendienteARCA</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Venta" name="Venta confirmada">
      <bpmn:documentation>Etapa del proceso de facturacion automatizada de Masterpiece.</bpmn:documentation>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Venta" messageRef="Message_Venta"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Centralizar" name="Centralizar venta y datos del cliente">
      <bpmn:documentation>Registra el canal comercial, cliente, productos, importes, fecha y estado de la venta. Entidades Cliente y Venta.</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Validar" name="Validar datos fiscales y condicion facturable">
      <bpmn:documentation>Valida datos necesarios para facturacion y bandera Facturable de Venta, sin inventar una politica fiscal detallada.</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Aptitud" name="Venta apta para facturar?" default="Flow_05_No">
      <bpmn:documentation>Etapa del proceso de facturacion automatizada de Masterpiece.</bpmn:documentation>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Si</bpmn:outgoing>
      <bpmn:outgoing>Flow_05_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Preparar" name="Preparar solicitud de comprobante fiscal">
      <bpmn:documentation>Prepara datos para el comprobante fiscal a partir de Cliente y Venta.</bpmn:documentation>
      <bpmn:incoming>Flow_04_Si</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Enviar" name="Solicitar autorizacion a ARCA" messageRef="Message_Solicitud">
      <bpmn:documentation>Interaccion del sistema con ARCA para solicitar autorizacion del comprobante electronico.</bpmn:documentation>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_Recibir" name="Recibir resultado de ARCA" messageRef="Message_Resultado">
      <bpmn:documentation>Obtiene el resultado de ARCA; si se autoriza, se recupera el CAE.</bpmn:documentation>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_ARCA" name="Comprobante autorizado?" default="Flow_10_No">
      <bpmn:documentation>Etapa del proceso de facturacion automatizada de Masterpiece.</bpmn:documentation>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Si</bpmn:outgoing>
      <bpmn:outgoing>Flow_10_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Guardar" name="Registrar factura, numero, CAE y estado">
      <bpmn:documentation>Persiste la entidad Factura: NumeroComprobante, CAE, ImporteTotal, FechaEmision, EstadoFactura e IdVenta.</bpmn:documentation>
      <bpmn:incoming>Flow_09_Si</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Stock" name="Actualizar stock disponible">
      <bpmn:documentation>Actualiza Producto.StockDisponible al facturar, de acuerdo con la propuesta de Entrega 1.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Exito" name="Factura autorizada y stock actualizado">
      <bpmn:documentation>Etapa del proceso de facturacion automatizada de Masterpiece.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_RevisarVenta" name="Revisar datos o elegibilidad de la venta">
      <bpmn:documentation>Excepcion: revision humana de datos fiscales o falta de requisitos. Reprocesamiento posterior fuera del alcance de este diagrama.</bpmn:documentation>
      <bpmn:incoming>Flow_05_No</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_PendienteDatos" name="Facturacion pendiente por datos o elegibilidad">
      <bpmn:documentation>Etapa del proceso de facturacion automatizada de Masterpiece.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Incidencia" name="Gestionar rechazo o incidencia fiscal de ARCA">
      <bpmn:documentation>Excepcion: rechazo o incidencia de autorizacion fiscal. No se registra CAE ni se descuenta stock.</bpmn:documentation>
      <bpmn:incoming>Flow_10_No</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_PendienteARCA" name="Facturacion pendiente por incidencia fiscal">
      <bpmn:documentation>Etapa del proceso de facturacion automatizada de Masterpiece.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" name="" sourceRef="Start_Venta" targetRef="Task_Centralizar"/>
    <bpmn:sequenceFlow id="Flow_02" name="" sourceRef="Task_Centralizar" targetRef="Task_Validar"/>
    <bpmn:sequenceFlow id="Flow_03" name="" sourceRef="Task_Validar" targetRef="Gateway_Aptitud"/>
    <bpmn:sequenceFlow id="Flow_04_Si" name="Si" sourceRef="Gateway_Aptitud" targetRef="Task_Preparar"/>
    <bpmn:sequenceFlow id="Flow_05_No" name="No" sourceRef="Gateway_Aptitud" targetRef="Task_RevisarVenta"/>
    <bpmn:sequenceFlow id="Flow_06" name="" sourceRef="Task_Preparar" targetRef="Task_Enviar"/>
    <bpmn:sequenceFlow id="Flow_07" name="" sourceRef="Task_Enviar" targetRef="Task_Recibir"/>
    <bpmn:sequenceFlow id="Flow_08" name="" sourceRef="Task_Recibir" targetRef="Gateway_ARCA"/>
    <bpmn:sequenceFlow id="Flow_09_Si" name="Si" sourceRef="Gateway_ARCA" targetRef="Task_Guardar"/>
    <bpmn:sequenceFlow id="Flow_10_No" name="No" sourceRef="Gateway_ARCA" targetRef="Task_Incidencia"/>
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="Task_Guardar" targetRef="Task_Stock"/>
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="Task_Stock" targetRef="End_Exito"/>
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="Task_RevisarVenta" targetRef="End_PendienteDatos"/>
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="Task_Incidencia" targetRef="End_PendienteARCA"/>
    <bpmn:dataObject id="DataObject_ClienteVenta" name="Cliente y Venta"/>
    <bpmn:dataObjectReference id="DataRef_ClienteVenta" dataObjectRef="DataObject_ClienteVenta" name="Cliente y Venta"/>
    <bpmn:dataObject id="DataObject_Factura" name="Factura: numero, CAE, estado"/>
    <bpmn:dataObjectReference id="DataRef_Factura" dataObjectRef="DataObject_Factura" name="Factura: numero, CAE, estado"/>
    <bpmn:dataObject id="DataObject_Producto" name="Producto: StockDisponible"/>
    <bpmn:dataObjectReference id="DataRef_Producto" dataObjectRef="DataObject_Producto" name="Producto: StockDisponible"/>
    <bpmn:association id="Assoc_Venta" sourceRef="Task_Centralizar" targetRef="DataRef_ClienteVenta" associationDirection="None"/>
    <bpmn:association id="Assoc_Factura" sourceRef="Task_Guardar" targetRef="DataRef_Factura" associationDirection="None"/>
    <bpmn:association id="Assoc_Producto" sourceRef="Task_Stock" targetRef="DataRef_Producto" associationDirection="None"/>
  </bpmn:process>
